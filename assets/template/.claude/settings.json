{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable-gems \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require_doc_template.rb"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable-gems \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/surface_conventions.rb"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable-gems \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint_changed_files.rb",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "ruby --disable-gems \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_doc_index.rb"
          }
        ]
      }
    ]
  }
}
